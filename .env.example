# Variables públicas de la tienda (ADR-F010). Terminan en el bundle: nunca lleven un secreto.

# Base de la API de base-shop, sin el prefijo /v1 ni barra final.
# El origen de la tienda (http://localhost:3002) debe estar en CORS_ALLOWED_ORIGINS de la API.
NUXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Versión vigente del aviso de privacidad, la misma que usa el backoffice (API_GAPS G-01).
# Vacía, la tienda no permite registrarse ni comprar como invitado.
NUXT_PUBLIC_PRIVACY_NOTICE_VERSION=
